{
  "name": "threejs-journey-exercise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "run_specs": "bun test specs/",
    "dev": "vite",
    "start": "bun run server.ts",
    "server_dev": "bun run --watch server.ts",
    "build": "vite build",
    "deploy": "vite build && npx wrangler pages deploy dist",
    "server_start": "bun run server.js --watch",
    "publish": "npm run build && ntl deploy --prod",
    "tailwind": "tailwindcss -i ./src/input.css -o ./src/output.css --watch"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-mdcs": "^5.0.0",
    "eslint-plugin-compat": "^6.0.1",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-import": "^2.31.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite-plugin-top-level-await": "^1.4.4"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/cli": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tweenjs/tween.js": "^25.0.0",
    "d3": "^7.9.0",
    "deck.gl": "^9.3.4",
    "esbuild": "^0.28.1",
    "gsap": "^3.12.5",
    "lil-gui": "^0.19.2",
    "mapbox-gl": "^3.25.0",
    "maplibre-gl": "^5.24.0",
    "marked": "^18.0.6",
    "ollama": "^0.5.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-map-gl": "^8.1.1",
    "react-router-dom": "^7.11.0",
    "rollup": "^4.62.2",
    "three": "^0.172.0",
    "underscore": "^1.13.7",
    "vite-plugin-markdown": "^2.2.0"
  }
